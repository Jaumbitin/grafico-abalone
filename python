import pandas as pd
import matplotlib.pyplot as plt

# carregando o arquivo csv
df = pd.read_csv('abalone.csv')

# um grafico mostrando o comprimento médio por sexo
plt.figure(figsize=(7, 5))

# calculando a média do comprimento(Lenght) agrupado pelo sexo 
media_comprimento = df.groupby('Sex')['Length'].mean()

# gerando o gráfico de barras
media_comprimento.plot(kind='bar', color=['r', 'b', 'g'])

# Personalizar o gráfico
plt.title('Comprimento Médio dos Abalones por Sexo', fontsize=12, fontweight='bold')
plt.xlabel('Sexo (F = Fêmea, I = Infantil, M = Macho)')
plt.ylabel('Comprimento Médio')
plt.xticks(rotation=0)
plt.tight_layout()

# Salvar e fechar
plt.savefig('grafico_abalone_simples.png', dpi=150)
plt.close()
